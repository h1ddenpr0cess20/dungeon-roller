+    this.party = party;
+    this.heroes = party.heroes;
+    this.inventory = party.inventory;
+    this.random = random;
+    this.settings = { autoMode: 0, battleSpeed: 1, autoItems: true, autoLimits: true, autoContinue: true, ...settings };
+    this.enemies = foes.slice(0, 3).map((kind, i) => makeFoe(kind, kind === 'dragon' ? Math.max(level, averageLevel(party)) : level, i));
