+    },
+
+    draw() {
+      if (!battle) return;
+      buttons = [];
+      ctx.save();
+      const sx = shake ? (Math.random() - 0.5) * shake * 2 : 0, sy = shake ? (Math.random() - 0.5) * shake * 2 : 0;
+      ctx.translate(sx, sy);
+      ctx.beginPath();
+      ctx.rect(0, 0, W, VIEW_H);
+      ctx.clip();
+      drawBackdrop();
+      drawUnits();
+      drawEffects();
+      drawOpening();
+      ctx.restore();
+      if (battle.phase === 'victory') drawResult();
+      else drawPartyPanel();
+      drawTop();
+    },
+  };
+}
