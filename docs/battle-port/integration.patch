@@ -0,0 +1,944 @@
+import { grantXP } from '../party.js';
+import { AUTO_MODES, FOES, HEROES, ITEMS, OPENINGS, SKILL_LEVELS } from './data.js';
+import { MONSTERS } from '../monsters.js';
+
+/**
+ * A fight, without anything drawn: capitol-quest's battle system, ported.
+ * The party moves hero by hero — attack, a skill, an item, defend, analyze
+ * or disengage — then every monster acts on the intent it showed at the top
+ * of the round. Hitting a monster's weakness twice BREAKs it, and it loses
+ * its next move. Skills cost MP; hits build each hero's LIMIT, and a full
+ * gauge unlocks a limit skill. Statuses (ATK up, DEF down, regen...) wear
+ * off round by round. Auto-battle can play any hero.
+ *
+ * What capitol-quest doesn't have is the die. The number on top when the
+ * die ran into the monster sets the fight up (`OPENINGS` in data.js): a
+ * natural 20 catches every enemy flat, a roll over the DC gives the party
+ * the first strike and its blood up, under the DC the monsters move first,
+ * and a natural 1 leaves the party off balance as well.
+ *
+ * The battle screen (`screen.js`) draws it, reads `events` for the
+ * numbers, sparks and sounds, and passes keys and clicks to `input` and the
+ * choose/confirm methods. The tests play it with auto-battle alone.
+ */
+
+/**
+ * Monsters grow this much a level: HP, then ATK and MAG — capitol-quest's
+ * curve, a little tougher, as nothing down here gives the party a rest
+ * point between fights.
+ */
+const growth = (level) => ({ hp: (0.82 + (level - 1) * 0.095) * 1.25, power: (0.85 + (level - 1) * 0.09) * 1.12, def: 0.9 + (level - 1) * 0.06 });
+
+/** How long the beats of a move take, in seconds at 1× speed. */
+const BEATS = { intro: 0.9, hero: 0.82, heroHit: 0.36, foe: 0.72, foeHit: 0.31, message: 0.55 };
+
+const STATUS = {
+  atkUp: 'ATK↑', defUp: 'DEF↑', magUp: 'MAG↑', atkDown: 'ATK↓', defDown: 'DEF↓', magDown: 'MAG↓',
+  vulnerable: 'VULN', regen: 'REGEN', mpRegen: 'MP+',
+};
+
+export const statusText = (u) => Object.keys(u.status || {}).map((k) => STATUS[k]).filter(Boolean).join(' ');
+
+export function makeFoe(kind, level, i = 0) {
+  const d = FOES[kind];
+  const g = growth(level);
+  const hp = Math.round(d.hp * g.hp * (d.boss ? 2.1 : 1));
+  return {
+    kind, i, label: d.label, level, maxHp: hp, hp,
+    atk: Math.round(d.atk * g.power), def: Math.round(d.def * g.def), mag: Math.round(d.mag * g.power),
+    ai: d.ai, trait: d.trait, weak: d.weak, boss: !!d.boss, gold: MONSTERS[kind]?.gold ?? 10,
