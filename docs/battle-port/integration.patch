+
+  // ————————————————————————————————————— the monsters' moves
+
+  refreshIntents() {
+    for (const e of this.enemies) e.intent = this.planIntent(e);
+  }
+
+  /** What a monster means to do this round, shown over its head. */
+  planIntent(e) {
