+      this.emit('sfx', { name: 'error' });
+      return;
+    }
+    if (!s.limit && h.mp < s.cost) {
+      this.message = 'NOT ENOUGH MP.';
+      this.phase = 'message';
+      this.pending = null;
+      this.emit('sfx', { name: 'error' });
+      return;
+    }
+    this.pending = { kind: 'skill', skill: s, targetType: s.target === 'enemy' ? 'enemy' : s.target === 'ally' ? 'ally' : null };
