+      shake = 0;
+      shell.hidden = false;
+      canvas.focus({ preventScroll: true });
+      return new Promise((r) => { resolve = r; });
+    },
+
+    /** A key from elsewhere (the gamepad): 'enter', 'escape', arrows. */
+    key(k) { if (battle) battle.input(k); },
+
+    update(dt) {
+      if (!battle) return;
+      time += dt;
+      battle.update(dt);
+      takeEvents();
+      stepEffects(dt);
