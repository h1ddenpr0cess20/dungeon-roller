+    const crit = this.random() < (a.luck || 8) / 250 + critBonus;
+    if (t.status?.vulnerable) base *= 1.22;
+    if (t.guard) base *= 0.5;
+    if (crit) base *= 1.55;
+    return { amount: Math.max(1, Math.round(base)), crit };
+  }
+
+  damageMagic(a, t, power = 1) {
+    let base = this.effective(a, 'mag') * power - this.effective(t, 'def') * 0.26 + this.rand(-2, 3);
+    if (t.status?.vulnerable) base *= 1.22;
+    if (t.guard) base *= 0.62;
+    return { amount: Math.max(1, Math.round(base)), crit: false };
+  }
+
+  damageHybrid(a, t, power = 1) {
