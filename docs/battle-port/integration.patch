+      if (battle.pending.targetType === 'enemy' && t) {
+        panelText(`${t.analyzed ? `Weak: ${t.weak.toUpperCase()} · ` : ''}${t.resolveTurns ? 'RESOLVE: can\'t break' : `Break ${t.breakPoints || 0}/2`}`, x, 585, 14, '#90d5e9');
