+    this.round = 1;
+    this.phase = 'intro';
+    this.timer = BEATS.intro;
+    this.menuIndex = 0;
+    this.subIndex = 0;
+    this.targetIndex = 0;
+    this.pending = null;
+    this.action = null;
+    this.enemyQueue = [];
+    this.enemyIndex = 0;
+    this.autoClock = 0;
+    this.messageClock = 0;
+    this.resultClock = 0;
+    this.breaks = 0;
+    this.events = [];
+    this.done = null;
+    this.result = null;
+    this.roll = roll;
+    this.dc = dc;
+    this.opening = roll >= 20 ? 'critical' : roll <= 1 ? 'fumble' : roll >= dc ? 'advantage' : 'surprised';
+    for (const h of this.heroes) {
+      h.alive = h.hp > 0;
+      h.guard = false;
+      h.status = {};
+      h.hitTimer = 0;
+    }
+    this.actorIndex = Math.max(0, this.heroes.findIndex((h) => h.alive));
+    // The die's say in it.
+    if (this.opening === 'critical') {
+      for (const e of this.enemies) e.broken = true;
+      for (const h of this.heroes) h.limit = Math.min(100, h.limit + 50);
+    } else if (this.opening === 'advantage') {
+      for (const h of this.heroes) this.addStatus(h, 'atkUp', 2);
+    } else if (this.opening === 'fumble') {
+      for (const h of this.heroes) this.addStatus(h, 'defDown', 2);
+    }
+    this.refreshIntents();
+    const names = this.enemies.map((e) => e.label).join(' + ');
+    this.message = `${label} · ${names} · ROLLED ${roll} vs DC ${dc}: ${OPENINGS[this.opening].title}`;
+    this.emit('sfx', { name: 'confirm' });
+  }
+
+  // ————————————————————————————————————— helpers
+
+  rand(a, b) { return Math.floor(this.random() * (b - a + 1)) + a; }
+
+  choice(list) { return list[Math.floor(this.random() * list.length)]; }
+
+  emit(type, data = {}) { this.events.push({ type, ...data }); }
+
+  floater(who, text, color) { this.emit('floater', { who, text, color }); }
+
+  fx(kind, who) { this.emit('fx', { kind, who }); }
+
+  aliveParty() { return this.heroes.filter((h) => h.alive && h.hp > 0); }
+
+  aliveEnemies() { return this.enemies.filter((e) => e.hp > 0); }
+
+  currentActor() { return this.heroes[this.actorIndex]; }
+
+  isHero(u) { return this.heroes.includes(u); }
+
+  addStatus(u, key, turns) { u.status[key] = Math.max(u.status[key] || 0, turns); }
+
+  effective(u, stat) {
+    let v = u[stat];
+    const st = u.status || {};
+    if (stat === 'atk') { if (st.atkUp) v *= 1.25; if (st.atkDown) v *= 0.76; }
+    if (stat === 'def') { if (st.defUp) v *= 1.3; if (st.defDown) v *= 0.76; }
+    if (stat === 'mag') { if (st.magUp) v *= 1.25; if (st.magDown) v *= 0.76; }
+    return v;
+  }
+
+  // ————————————————————————————————————— damage
+
+  damagePhysical(a, t, power = 1, critBonus = 0) {
