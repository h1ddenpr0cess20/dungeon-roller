+
+const ENEMY_POS = [
+  [{ x: 985, y: 400 }],
+  [{ x: 880, y: 345 }, { x: 1110, y: 420 }],
+  [{ x: 820, y: 350 }, { x: 1010, y: 430 }, { x: 1165, y: 315 }],
+];
+
+export function createBattleScreen({ audio }) {
+  const shell = document.createElement('div');
+  shell.id = 'battle';
+  shell.hidden = true;
+  const canvas = document.createElement('canvas');
+  canvas.width = W;
+  canvas.height = H;
+  canvas.setAttribute('aria-label', 'Battle');
+  canvas.tabIndex = 0;
+  shell.appendChild(canvas);
+  document.body.appendChild(shell);
+  const ctx = canvas.getContext('2d');
+
+  let battle = null;
+  let resolve = null;
+  let palette = null;
+  let backdrop = null;
+  let time = 0;
+  let shake = 0;
+  let buttons = [];
+  const pointer = { x: -1, y: -1 };
+  let particles = [], floaters = [], flashes = [], projectiles = [];
+
+  // ——————————————————————————————————————— drawing helpers
+
+  function text(s, x, y, size = 18, color = '#fff', align = 'left', weight = 700) {
+    ctx.fillStyle = color;
+    ctx.font = `${weight} ${size}px ${FONT}`;
+    ctx.textAlign = align;
+    ctx.textBaseline = 'top';
+    ctx.fillText(String(s), Math.round(x), Math.round(y));
+  }
+  const panelText = (s, x, y, size = 16, color = '#e6dfd2', align = 'left') => text(s, x, y, size, color, align, 500);
+
+  function wrap(s, x, y, maxW, size = 16, color = '#c8bfb2', maxLines = 3) {
+    ctx.font = `500 ${size}px ${FONT}`;
+    ctx.textAlign = 'left';
+    ctx.textBaseline = 'top';
+    ctx.fillStyle = color;
+    let line = '', yy = y, lines = 0;
+    for (const word of String(s).split(' ')) {
+      const test = line ? `${line} ${word}` : word;
+      if (ctx.measureText(test).width > maxW && line) {
+        ctx.fillText(line, x, yy);
+        yy += size * 1.45;
+        if (++lines >= maxLines) return yy;
+        line = word;
+      } else line = test;
+    }
+    if (line) ctx.fillText(line, x, yy);
+    return yy + size * 1.45;
+  }
+
+  function box(x, y, w, h, fill = '#1a1412', stroke = '#4a3e36') {
+    ctx.fillStyle = fill;
