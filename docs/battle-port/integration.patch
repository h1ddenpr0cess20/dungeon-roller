+    }
+  }
+
+  chooseItem(key) {
+    this.pending = { kind: 'item', item: key, targetType: 'ally' };
+    this.targetIndex = 0;
+    this.phase = 'target';
+  }
+
+  confirmTarget(target) {
+    const h = this.currentActor(), pd = this.pending;
+    if (!pd || !target) return;
