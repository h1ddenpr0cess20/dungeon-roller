+        break;
+      case 'shield':
+        if (round % 3 === 2) return { kind: 'guard', label: 'Raise shield · armor up', power: 1 };
+        break;
+      case 'stab':
+        if (round % 3 === 0) return { kind: 'disrupt', label: 'Dirty trick · lowers MAG', power: 0.9 };
+        break;
+      case 'brute':
+        if (round % 3 === 2) return { kind: 'guard', label: 'Brace · armor up', power: 1 };
+        if (round % 3 === 0) return { kind: 'physical', label: 'Smash · heavy strike', power: 1.3 };
+        break;
+      case 'acid':
+        if (round % 2 === 0) return { kind: 'corrode', label: 'Acid · lowers DEF', power: 0.9 };
+        return { kind: 'magic', label: 'Spit', power: 1 };
+      case 'wail':
+        if (round % 3 === 0) return { kind: 'sweep', label: 'WAIL · all heroes', power: 0.8, magic: true };
+        return { kind: 'magic', label: 'Chill touch', power: 1 };
+      case 'dragon':
+        if (round % 3 === 0) return { kind: 'sweep', label: 'FIRE BREATH · all heroes', power: 1.05, magic: true };
+        if (low < 0.4) return { kind: 'physical', label: 'FURY · rending claws', power: 1.5 };
+        return { kind: 'physical', label: 'Claw', power: 1.2 };
+    }
+    return { kind: 'physical', label: e.resolveTurns ? 'RESOLVE · strike' : 'Strike', power: e.boss ? 1.2 : 1 };
+  }
+
+  resolveEnemyAction(e) {
+    if (e.broken) {
+      e.broken = false;
+      e.resolveTurns = 2;
+      e.intent = this.planIntent(e);
+      this.message = `${e.label} is broken and loses its move.`;
+      return;
+    }
+    const move = e.intent || this.planIntent(e), living = this.aliveParty();
+    if (!living.length) return this.lose();
+    this.message = `${e.label}: ${move.label}.`;
+    if (move.kind === 'guard') {
+      e.guard = true;
+      this.addStatus(e, 'defUp', 2);
+      return;
+    }
+    // The front of the line takes more of it.
+    const targets = move.kind === 'sweep' ? living : [this.pickTarget(living)];
+    for (const t of targets) {
+      const magic = ['magic', 'disrupt', 'corrode'].includes(move.kind) || move.magic;
+      const res = magic ? this.damageMagic(e, t, move.power) : this.damagePhysical(e, t, move.power);
+      this.applyDamage(t, res);
+      if (move.kind === 'disrupt') this.addStatus(t, 'magDown', 2);
+      if (move.kind === 'corrode') this.addStatus(t, 'defDown', 2);
+      if (move.kind === 'drain') {
+        const back = Math.round(res.amount * 0.6);
+        e.hp = Math.min(e.maxHp, e.hp + back);
+        this.floater(e, `+${back}`, '#9ee6b8');
+      }
+      this.fx(magic ? 'magic' : 'claw', t);
+    }
+    if (!this.aliveParty().length) this.lose();
+  }
+
+  pickTarget(living) {
+    const weight = (h) => ({ hero: 3, warrior: 4, mage: 2, healer: 2 }[h.id] ?? 2) * (h.guard ? 1.5 : 1);
+    let pick = this.random() * living.reduce((s, h) => s + weight(h), 0);
+    for (const h of living) {
+      pick -= weight(h);
+      if (pick < 0) return h;
+    }
+    return living[living.length - 1];
+  }
+
+  // ————————————————————————————————————— whose turn
+
+  advancePlayer() {
+    this.pending = null;
+    let i = this.actorIndex + 1;
+    while (i < this.heroes.length && !this.heroes[i].alive) i++;
+    if (i < this.heroes.length) {
+      this.actorIndex = i;
+      this.menuIndex = 0;
+      this.phase = 'input';
+      return;
+    }
+    this.startEnemyPhase();
+  }
+
+  startEnemyPhase() {
+    for (const e of this.enemies) e.guard = false;
+    this.enemyQueue = this.aliveEnemies().slice();
+    this.enemyIndex = 0;
+    this.phase = 'enemyAction';
+    this.startEnemyAction();
+  }
+
+  startEnemyAction() {
+    const round = this.round;
+    this.advanceEnemyTurn();
+    if (this.round !== round) {
+      for (const e of this.enemies) e.resolveTurns = Math.max(0, (e.resolveTurns || 0) - 1);
+      this.refreshIntents();
+    }
+  }
+
+  advanceEnemyTurn() {
+    if (this.phase === 'defeat') return;
+    if (this.enemyIndex >= this.enemyQueue.length) {
+      this.tickStatuses(this.heroes);
+      this.tickStatuses(this.enemies);
+      for (const h of this.heroes) h.guard = false;
+      this.round++;
+      this.actorIndex = 0;
+      while (this.actorIndex < this.heroes.length && !this.heroes[this.actorIndex].alive) this.actorIndex++;
+      if (this.actorIndex >= this.heroes.length) return this.lose();
+      this.phase = 'input';
+      this.menuIndex = 0;
+      return;
+    }
+    const e = this.enemyQueue[this.enemyIndex];
+    if (e.hp <= 0) {
+      this.enemyIndex++;
+      return this.advanceEnemyTurn();
+    }
+    this.action = { kind: 'enemy', actor: e, t: 0, applied: false, duration: BEATS.foe };
+    this.phase = 'enemyAction';
+  }
+
+  // ————————————————————————————————————— the end of it
+
+  win() {
+    if (this.phase === 'victory') return;
+    const level = Math.max(...this.enemies.map((e) => e.level));
+    // capitol-quest's reward, scaled down: a delve has a good deal more fights in it than a district.
+    const xp = this.boss ? 140 + level * 24 : 20 + level * 8 + this.enemies.length * 6;
+    const gold = this.enemies.reduce((s, e) => s + e.gold, 0) * (this.opening === 'critical' ? 2 : 1);
+    for (const h of this.heroes) h.limit = Math.min(100, h.limit + 6);
+    const gains = grantXP(this.party, xp);
+    // A breather after a win: some HP and MP back.
+    for (const h of this.heroes) {
+      if (!h.alive) continue;
+      h.hp = Math.min(h.maxHp, h.hp + Math.round(h.maxHp * 0.12));
+      h.mp = Math.min(h.maxMp, h.mp + Math.round(h.maxMp * 0.1));
+    }
+    this.phase = 'victory';
+    this.result = { won: true, xp, gold, gains, rounds: this.round, breaks: this.breaks };
+    this.resultClock = 0;
+    this.message = `VICTORY · +${xp} XP · +${gold} GOLD`;
+    this.emit('sfx', { name: 'victory' });
+  }
+
+  lose() {
+    if (this.phase === 'defeat') return;
+    this.phase = 'defeat';
+    this.action = null;
+    this.message = 'THE PARTY HAS FALLEN.';
+    this.emit('sfx', { name: 'defeat' });
+  }
+
+  /** Leave the fight: `how` is 'won', 'fled', 'retry' or 'fallen'. */
+  finish(how) {
+    if (this.done) return;
+    for (const h of this.heroes) { h.status = {}; h.guard = false; }
+    this.done = { how, result: this.result };
+  }
+
+  // ————————————————————————————————————— time
+
+  update(dt) {
+    if (this.done) return;
+    const speed = this.settings.battleSpeed || 1;
+    const step = dt * speed;
+    for (const u of [...this.heroes, ...this.enemies]) u.hitTimer = Math.max(0, (u.hitTimer || 0) - dt);
+
+    if (this.phase === 'intro') {
+      this.timer -= step;
+      if (this.timer <= 0) {
+        if (this.opening === 'surprised' || this.opening === 'fumble') {
+          this.message = 'The monsters move first!';
+          this.startEnemyPhase();
+        } else {
+          this.phase = 'input';
+          this.actorIndex = Math.max(0, this.heroes.findIndex((h) => h.alive));
+        }
+      }
+    } else if (this.phase === 'action' && this.action) {
+      const a = this.action;
+      a.t += step;
+      if (a.t > BEATS.heroHit && !a.applied) {
+        a.applied = true;
+        this.resolvePlayerAction(a);
+      }
+      if (this.phase === 'action' && a.t >= a.duration && a.resolved) {
+        this.action = null;
+        if (a.willWin) this.win();
+        else {
+          this.phase = 'message';
+          this.pending = { advanceAfterMessage: true };
+          this.messageClock = 0;
+        }
+      }
+    } else if (this.phase === 'enemyAction' && this.action) {
+      const a = this.action;
+      a.t += step;
+      if (a.t > BEATS.foeHit && !a.applied) {
+        a.applied = true;
+        this.resolveEnemyAction(a.actor);
+      }
+      if (this.phase === 'enemyAction' && this.action && a.t >= a.duration) {
+        this.enemyIndex++;
+        this.action = null;
+        this.startEnemyAction();
+      }
+    } else if (this.phase === 'message' && this.pending?.advanceAfterMessage) {
+      this.messageClock += step;
+      if (this.messageClock > BEATS.message) {
+        this.messageClock = 0;
+        this.advancePlayer();
+      }
+    } else if (this.phase === 'fled') {
+      this.timer -= step;
+      if (this.timer <= 0) this.finish('fled');
+    }
+
+    if (this.phase === 'input' && this.settings.autoMode) {
+      this.autoClock += step;
+      if (this.autoClock >= 0.42) {
+        this.autoClock = 0;
+        this.chooseAuto();
+      }
+    } else this.autoClock = 0;
+    if (this.phase === 'message' && !this.pending?.advanceAfterMessage && this.settings.autoMode) {
+      this.phase = 'input';
+      this.pending = null;
+    }
+    if (this.phase === 'victory' && this.settings.autoContinue && this.settings.autoMode && !this.result.gains.length && !this.boss) {
+      this.resultClock += dt;
+      if (this.resultClock > 1.5) this.finish('won');
+    }
+  }
+
+  // ————————————————————————————————————— auto-battle
+
+  cycleAuto() {
+    this.setAuto((this.settings.autoMode + 1) % AUTO_MODES.length);
+  }
+
+  setAuto(n) {
+    this.settings.autoMode = n;
+    this.autoClock = 0;
+    if (['skills', 'target', 'items', 'analyze'].includes(this.phase)) {
+      this.phase = 'input';
+      this.pending = null;
+    }
+  }
+
+  /** capitol-quest's auto-battle: revive, heal, guard against a charge, break weaknesses, spend MP by strategy. */
+  chooseAuto() {
+    const h = this.currentActor();
+    if (!h?.alive) { this.advancePlayer(); return; }
+    const settings = this.settings, strategy = settings.autoMode;
+    const enemies = this.aliveEnemies(), allies = this.aliveParty();
+    if (!enemies.length) { this.win(); return; }
+    const affordable = this.skillsFor(h).filter((s) => (s.limit ? settings.autoLimits : s.cost <= h.mp));
+    const hurtMost = [...allies].sort((a, b) => a.hp / a.maxHp - b.hp / b.maxHp)[0];
+    const fallen = this.heroes.find((t) => !t.alive);
+    const cast = (s, ts) => this.beginPlayerAction({ kind: 'skill', actor: h, skill: s, targets: ts, pose: s.pose });
+    const revive = affordable.find((s) => s.kind === 'revive' || (s.limit && s.revive));
+    if (fallen && revive) { cast(revive, revive.kind === 'revive' ? [fallen] : allies); return; }
+    if (fallen && settings.autoItems && this.inventory.PHOENIX) {
+      this.beginPlayerAction({ kind: 'item', actor: h, item: 'PHOENIX', target: fallen, pose: 'support' });
+      return;
+    }
+    const healing = affordable.filter((s) => /^heal/.test(s.kind));
+    const low = allies.filter((t) => t.hp / t.maxHp < (strategy === 2 ? 0.4 : 0.65));
+    if (low.length >= 2) {
+      const aoe = healing.find((s) => s.kind.includes('All'));
+      if (aoe) { cast(aoe, allies); return; }
+    }
+    if (hurtMost.hp / hurtMost.maxHp < (strategy === 2 ? 0.28 : 0.52)) {
+      const heal = healing.find((s) => !s.kind.includes('All')) || healing[0];
+      if (heal) { cast(heal, heal.target === 'allies' ? allies : [hurtMost]); return; }
+      if (settings.autoItems) {
+        const key = this.inventory.HIPOTION ? 'HIPOTION' : this.inventory.POTION ? 'POTION' : this.inventory.PHOENIX ? 'PHOENIX' : null;
+        if (key) {
+          this.beginPlayerAction({ kind: 'item', actor: h, item: key, target: hurtMost, pose: 'support' });
+          return;
+        }
+      }
+    }
+    const charging = enemies.some((e) => !e.broken && e.intent?.kind === 'sweep');
+    if (strategy !== 2 && charging && h.hp / h.maxHp < 0.65) {
+      this.beginPlayerAction({ kind: 'guard', actor: h, pose: 'support' });
+      return;
+    }
+    const hitType = HEROES[h.id].basic.type;
+    const score = (e) => (e.weak === hitType ? 2 : 0) + (e.breakPoints || 0) * 2 + (1 - e.hp / e.maxHp);
+    const target = [...enemies].sort((a, b) => score(b) - score(a))[0];
+    const offensive = affordable.filter((s) => /^(physical|hybrid|magic)/.test(s.kind));
+    const limit = offensive.find((s) => s.limit);
+    if (limit) { cast(limit, limit.target === 'enemies' ? enemies : [target]); return; }
+    if (strategy !== 3) {
+      if (this.round === 1 && this.boss && h.id === 'hero' && !h.status.atkUp) {
+        const buff = affordable.find((s) => ['buffAtk', 'formation'].includes(s.kind));
+        if (buff) { cast(buff, allies); return; }
+      }
+      const reserve = strategy === 1 ? h.maxMp * 0.18 : 0;
+      const attack = offensive
+        .filter((s) => h.mp - s.cost >= reserve)
+        .sort((a, b) => {
+          const value = (s) => s.power * (s.target === 'enemies' ? enemies.length * 0.86 : 1) * (target.weak === s.kind.replace('All', '') ? 1.16 : 1);
+          return value(b) - value(a);
+        })[0];
+      if (attack) { cast(attack, attack.target === 'enemies' ? enemies : [target]); return; }
+    }
+    this.beginPlayerAction({ kind: 'basic', actor: h, target, pose: 'attack' });
+  }
+
+  // ————————————————————————————————————— keys
+
+  /**
+   * A key, by name (lower case, as KeyboardEvent.key): arrows or WASD to
+   * move through the menus, Enter or Space to choose, Escape to go back,
+   * 1–6 for the commands, B to change auto-battle, V for speed.
+   */
+  input(k) {
+    if (k === 'b') { this.cycleAuto(); return; }
+    if (k === 'v') { this.settings.battleSpeed = (this.settings.battleSpeed % 3) + 1; return; }
+    if (k === 'escape' && this.settings.autoMode) { this.setAuto(0); return; }
+    if (k === 'e') k = 'enter';
+    const go = k === 'enter' || k === ' ';
+    if (this.phase === 'victory') { if (go) this.finish('won'); return; }
+    if (this.phase === 'defeat') return;
+    if (this.phase === 'message') {
+      if (!go) return;
+      const pd = this.pending;
+      this.pending = null;
+      this.emit('sfx', { name: 'confirm' });
+      if (pd?.advanceAfterMessage) this.advancePlayer();
+      else this.phase = 'input';
+      return;
+    }
+    if (['intro', 'action', 'enemyAction', 'fled'].includes(this.phase)) return;
+    if (k === 'escape') {
+      if (['skills', 'items', 'target', 'analyze'].includes(this.phase)) {
+        this.phase = 'input';
+        this.pending = null;
+        this.emit('sfx', { name: 'cancel' });
+      }
+      return;
+    }
+    const prev = ['arrowleft', 'a', 'arrowup', 'w'].includes(k), next = ['arrowright', 'd', 'arrowdown', 's'].includes(k);
+    const move = () => this.emit('sfx', { name: 'move' });
+    if (this.phase === 'input') {
+      if (k === 'arrowleft' || k === 'a') { this.menuIndex = (this.menuIndex + 5) % 6; move(); }
+      else if (k === 'arrowright' || k === 'd') { this.menuIndex = (this.menuIndex + 1) % 6; move(); }
+      else if (k === 'arrowup' || k === 'w') { this.menuIndex = (this.menuIndex + 4) % 6; move(); }
+      else if (k === 'arrowdown' || k === 's') { this.menuIndex = (this.menuIndex + 2) % 6; move(); }
+      else if (k >= '1' && k <= '6') { this.menuIndex = Number(k) - 1; this.commitMenu(); }
+      else if (go) this.commitMenu();
+      return;
+    }
+    if (this.phase === 'skills') {
+      const list = this.skillsFor(this.currentActor());
+      if (prev) { this.subIndex = (this.subIndex + list.length - 1) % list.length; move(); }
+      else if (next) { this.subIndex = (this.subIndex + 1) % list.length; move(); }
+      else if (go) this.chooseSkill(list[this.subIndex]);
+      return;
+    }
+    if (this.phase === 'items') {
+      const list = this.items();
+      if (!list.length) { this.phase = 'input'; return; }
+      if (prev) { this.subIndex = (this.subIndex + list.length - 1) % list.length; move(); }
+      else if (next) { this.subIndex = (this.subIndex + 1) % list.length; move(); }
+      else if (go) this.chooseItem(list[this.subIndex][0]);
+      return;
+    }
+    if (this.phase === 'target') {
+      const list = this.targets();
+      if (!list.length) return;
+      if (prev) { this.targetIndex = (this.targetIndex + list.length - 1) % list.length; move(); }
+      else if (next) { this.targetIndex = (this.targetIndex + 1) % list.length; move(); }
+      else if (go) this.confirmTarget(list[this.targetIndex]);
+      return;
+    }
+    if (this.phase === 'analyze') {
+      const list = this.aliveEnemies();
+      if (prev) { this.targetIndex = (this.targetIndex + list.length - 1) % list.length; move(); }
+      else if (next) { this.targetIndex = (this.targetIndex + 1) % list.length; move(); }
+      else if (go) this.analyze(list[this.targetIndex]);
+    }
+  }
+}
+
+function averageLevel(party) {
+  return Math.round(party.heroes.reduce((s, h) => s + h.lvl, 0) / party.heroes.length);
+}
+
+/**
+ * Play a fight out with auto-battle alone, `dt` at a time, until it is won,
+ * fled or lost: for the tests and the autopilot. Returns how it ended.
+ */
+export function autoResolve(battle, { mode = 1, dt = 0.1, limit = 900 } = {}) {
+  battle.settings.autoMode = mode;
+  battle.settings.battleSpeed = 3;
+  for (let t = 0; t < limit && !battle.done; t += dt) {
+    battle.update(dt);
+    battle.events.length = 0;
+    if (battle.phase === 'victory') battle.finish('won');
+    if (battle.phase === 'defeat') battle.finish('fallen');
+  }
+  return battle.done?.how ?? 'timeout';
+}
