+
+/** Which monsters come with the one the die ran into, `depth` levels down: a bigger pack from the third level on. */
+export function encounter(kind, depth) {
+  const f = FOES[kind];
+  return (depth >= 3 ? f.deepPack : f.pack).slice(0, 3);
+}
+
+/** How strong the monsters are, `depth` levels down. */
+export const foeLevel = (depth) => 1 + (depth - 1) * 2;
+
+export const ITEMS = {
+  POTION: { name: 'Potion', desc: 'Restore 40 HP.', heal: 40 },
+  HIPOTION: { name: 'Hi-Potion', desc: 'Restore 90 HP.', heal: 90 },
+  ETHER: { name: 'Ether', desc: 'Restore 20 MP.', mp: 20 },
+  PHOENIX: { name: 'Phoenix Down', desc: 'Revive, or restore 60 HP.', heal: 60, revive: true },
+};
+
+export const START_ITEMS = { POTION: 3, ETHER: 1, PHOENIX: 1 };
+
+/** Experience for the next level. */
+export const xpRequired = (lvl) => (lvl >= 30 ? 0 : 120 + (lvl - 1) * 60);
+
+/**
+ * How the d20 sets the fight up — capitol-quest has no dice; this is the
+ * dungeon's own. The roll is against the DC of the monster the die ran into.
+ */
+export const OPENINGS = {
+  critical: { title: 'CRITICAL ROLL', line: 'A natural 20: the party catches them flat. Every enemy loses its first move.' },
+  advantage: { title: 'ADVANTAGE', line: 'Over the DC: the party strikes first, fired up. ATK up for two rounds.' },
+  surprised: { title: 'SURPRISED', line: 'Under the DC: the monsters move first.' },
+  fumble: { title: 'FUMBLE', line: 'A natural 1: the monsters move first, and the party is off balance. DEF down for two rounds.' },
+};
+
+export function opening(roll, dc) {
+  if (roll >= 20) return 'critical';
+  if (roll <= 1) return 'fumble';
+  return roll >= dc ? 'advantage' : 'surprised';
+}
